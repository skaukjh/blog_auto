# 네이버 블로그 자동화(B) 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# 댓글 생성용 (OpenAI)
OPENAI_API_KEY=sk-proj-...

# Supabase 연결 - 두 가지 용도로 씁니다
#   1) blog_styles          : A(/format)가 저장한 문체를 읽음 (읽기 전용)
#   2) neighbor_target_list : 서로이웃 대상 닉네임 목록 (읽기·쓰기)
# 문체를 공유하려면 A(루트 .env.local)와 반드시 동일한 프로젝트를 가리켜야 합니다.
# 신형 키를 씁니다. 변수 이름은 과거 그대로지만 값은 sb_publishable_ / sb_secret_ 입니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...    # RLS 우회. 서버 전용, 절대 클라이언트로 노출 금지

# scripts/ 하위 디버깅 스크립트 전용 네이버 테스트 계정
# 절대 소스코드에 하드코딩하지 마세요
NAVER_TEST_ID=
NAVER_TEST_PW=
