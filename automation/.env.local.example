# 네이버 블로그 자동화(B) 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. .env.local 은 git에 올라가지 않습니다.

# 댓글 생성용 (OpenAI)
OPENAI_API_KEY=sk-proj-...

# 서로이웃 대상 목록(neighbor_target_list) 저장용 Supabase 연결
# 블로그 문체는 Supabase가 아니라 ../data/blog-style.txt 파일에서 읽습니다
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# scripts/ 하위 디버깅 스크립트 전용 네이버 테스트 계정
# 절대 소스코드에 하드코딩하지 마세요
NAVER_TEST_ID=
NAVER_TEST_PW=
