# AI 블로그 글 생성(A) 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. .env.local 은 git에 올라가지 않습니다.
# 네이버 자동화(B)는 automation/.env.local 을 따로 사용합니다.

# --- 필수 ---
OPENAI_API_KEY=sk-proj-...
AUTH_PASSWORD=                    # 로그인 비밀번호. 비어 있으면 로그인이 항상 거부됩니다
SESSION_SECRET=                   # 32자 이상 랜덤 문자열

# --- 선택: 없으면 해당 기능만 비활성화됩니다 ---
OPENAI_ASSISTANT_ID=              # 분석한 문체를 Assistant instruction에 동기화
GOOGLE_PLACES_API_KEY=            # 가게 정보 조회 (/api/place/search)
NAVER_CLIENT_ID=                  # 웹 검색 + 쇼핑 검색
NAVER_CLIENT_SECRET=
GOOGLE_CSE_ID=                    # 구글 웹 검색
GOOGLE_CSE_API_KEY=
